{
  "name": "lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Logistics Management System — Next.js + Express OOP + MongoDB",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "seed:reset": "npm --prefix backend run seed:reset",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend start"
  }
}
